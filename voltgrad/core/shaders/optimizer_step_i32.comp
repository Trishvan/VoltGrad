#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer InOutWeights { int weights[]; };
layout(std430, binding = 1) readonly buffer InGrads { int grads[]; };
layout(std430, binding = 2) buffer InOutVelocities { int velocities[]; };
layout(std430, binding = 3) buffer OutMeta { uint meta[]; }; // meta[0] = max_bits_needed

layout(push_constant) uniform PushConstants {
    uint count;
    int lr;
    int beta;
    uint shift;
    uint opt_type; // 0=SGD, 1=Momentum, 2=AdamQ
    int weight_decay;
} pc;

uint bits_needed_32(int val) {
    if (val == 0 || val == -1) return 2u;
    uint u = (val >= 0) ? uint(val) : uint(-val - 1);
    return uint(max(findMSB(u) + 2, 2));
}

int fixed_mul_shift(int a, int b, uint shift) {
    int hi;
    int lo;
    imulExtended(a, b, hi, lo);
    if (shift == 0u) {
        return lo;
    } else if (shift < 32u) {
        return (hi << (32u - shift)) | int(uint(lo) >> shift);
    } else {
        return hi >> (shift - 32u);
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    
    int g = grads[i];
    int curr_w = weights[i];
    int v = velocities[i];
    int step = 0;
    
    int one = 1 << pc.shift;
    
    if (pc.opt_type == 0u) {
        // SGD
        step = fixed_mul_shift(pc.lr, g, pc.shift);
    } else if (pc.opt_type == 1u) {
        // SGDMomentum: v = (beta * v + (1 - beta) * g) >> shift
        int t1_hi, t1_lo, t2_hi, t2_lo;
        imulExtended(pc.beta, v, t1_hi, t1_lo);
        imulExtended(one - pc.beta, g, t2_hi, t2_lo);
        int sum_hi = t1_hi + t2_hi;
        uint carry;
        uint sum_lo = uaddCarry(uint(t1_lo), uint(t2_lo), carry);
        sum_hi += int(carry);
        v = (sum_hi << (32u - pc.shift)) | int(sum_lo >> pc.shift);
        velocities[i] = v;
        
        step = fixed_mul_shift(pc.lr, v, pc.shift);
    } else {
        // AdamQ
        int t1_hi, t1_lo, t2_hi, t2_lo;
        imulExtended(pc.beta, v, t1_hi, t1_lo);
        imulExtended(one - pc.beta, g, t2_hi, t2_lo);
        int sum_hi = t1_hi + t2_hi;
        uint carry;
        uint sum_lo = uaddCarry(uint(t1_lo), uint(t2_lo), carry);
        sum_hi += int(carry);
        v = (sum_hi << (32u - pc.shift)) | int(sum_lo >> pc.shift);
        velocities[i] = v;
        
        int sign = 0;
        if (v > 0) sign = 1;
        else if (v < 0) sign = -1;
        step = (pc.lr * sign) >> 1;
    }
    
    if (pc.weight_decay > 0) {
        int decay = fixed_mul_shift(pc.weight_decay, curr_w, pc.shift);
        curr_w -= decay;
    }
    
    int new_w = curr_w - step;
    weights[i] = new_w;
    
    uint needed = bits_needed_32(new_w);
    atomicMax(meta[0], needed);
}
