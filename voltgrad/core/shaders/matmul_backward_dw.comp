#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InDOut { int d_out[]; };
layout(std430, binding = 1) readonly buffer InX { int x[]; };
layout(std430, binding = 2) buffer GradW { int64_t grad_w[]; };
layout(std430, binding = 3) buffer GradBias { int64_t grad_bias[]; };

layout(push_constant) uniform PushConstants {
    uint in_dim;
    uint out_dim;
    uint shift;
    uint use_bias;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.in_dim * pc.out_dim;
    if (idx >= total) return;
    
    uint r = idx / pc.in_dim;
    uint c = idx % pc.in_dim;
    
    int d_val = d_out[r];
    if (d_val != 0) {
        int x_val = x[c];
        int64_t prod = int64_t(d_val) * int64_t(x_val);
        int64_t g = prod >> pc.shift;
        grad_w[idx] += g;
    }
    
    if (c == 0u && pc.use_bias != 0u) {
        grad_bias[r] += int64_t(d_val);
    }
}
