#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InBatchDOut { int d_out[]; };
layout(std430, binding = 1) readonly buffer InBatchX { int x[]; };
layout(std430, binding = 2) buffer GradW { int grad_w[]; };
layout(std430, binding = 3) buffer GradBias { int grad_bias[]; };

layout(push_constant) uniform PushConstants {
    uint in_dim;
    uint out_dim;
    uint batch_size;
    uint shift;
    uint use_bias;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.in_dim * pc.out_dim;
    if (idx >= total) return;
    
    uint r = idx / pc.in_dim;
    uint c = idx % pc.in_dim;
    
    int sum_g = 0;
    for (uint b = 0u; b < pc.batch_size; b++) {
        int d_val = d_out[b * pc.out_dim + r];
        if (d_val != 0) {
            int x_val = x[b * pc.in_dim + c];
            int prod_hi;
            int prod_lo;
            imulExtended(d_val, x_val, prod_hi, prod_lo);
            
            int g = 0;
            if (pc.shift == 0u) {
                g = prod_lo;
            } else if (pc.shift < 32u) {
                g = (prod_hi << (32u - pc.shift)) | int(uint(prod_lo) >> pc.shift);
            } else {
                g = prod_hi >> (pc.shift - 32u);
            }
            sum_g += g;
        }
    }
    grad_w[idx] += sum_g;
    
    if (c == 0u && pc.use_bias != 0u) {
        int sum_bias = 0;
        for (uint b = 0u; b < pc.batch_size; b++) {
            sum_bias += d_out[b * pc.out_dim + r];
        }
        grad_bias[r] += sum_bias;
    }
}
