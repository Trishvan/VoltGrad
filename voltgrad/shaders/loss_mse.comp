#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InPreds { int preds[]; };
layout(std430, binding = 1) readonly buffer InTargets { int targets[]; };
layout(std430, binding = 2) writeonly buffer OutGrad { int grad[]; };
layout(std430, binding = 3) writeonly buffer OutLoss { int64_t loss[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint shift;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.count) return;
    
    int64_t diff = int64_t(preds[idx]) - int64_t(targets[idx]);
    grad[idx] = int(diff);
    loss[idx] = (diff * diff) >> pc.shift;
}
