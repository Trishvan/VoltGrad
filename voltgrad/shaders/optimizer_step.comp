#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer InOutWeights { int64_t weights[]; };
layout(std430, binding = 1) readonly buffer InGrads { int64_t grads[]; };
layout(std430, binding = 2) buffer InOutVelocities { int64_t velocities[]; };
layout(std430, binding = 3) buffer OutMeta { uint meta[]; }; // meta[0] = max_bits_needed

layout(push_constant) uniform PushConstants {
    uint count;
    int lr;
    int beta;
    uint shift;
    uint opt_type; // 0=SGD, 1=Momentum, 2=AdamQ
    int weight_decay;
} pc;

uint bits_needed_64(int64_t v) {
    if (v == 0l || v == -1l) return 2u;
    uint64_t u = (v >= 0l) ? uint64_t(v) : uint64_t(-v - 1l);
    uint high = uint(u >> 32u);
    if (high != 0u) {
        return uint(findMSB(high) + 34);
    }
    uint low = uint(u & 0xFFFFFFFFul);
    return uint(max(findMSB(low) + 2, 2));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    
    int64_t g = grads[i];
    int64_t curr_w = weights[i];
    int64_t v = velocities[i];
    int64_t step = 0l;
    
    int64_t one = int64_t(1) << pc.shift;
    
    if (pc.opt_type == 0u) {
        // SGD
        int64_t prod = int64_t(pc.lr) * g;
        step = prod >> pc.shift;
    } else if (pc.opt_type == 1u) {
        // SGDMomentum: v = (beta * v + (1 - beta) * g) >> shift
        int64_t term1 = int64_t(pc.beta) * v;
        int64_t term2 = int64_t(one - int64_t(pc.beta)) * g;
        v = (term1 + term2) >> pc.shift;
        velocities[i] = v;
        
        int64_t step_prod = int64_t(pc.lr) * v;
        step = step_prod >> pc.shift;
    } else {
        // AdamQ
        int64_t term1 = int64_t(pc.beta) * v;
        int64_t term2 = int64_t(one - int64_t(pc.beta)) * g;
        v = (term1 + term2) >> pc.shift;
        velocities[i] = v;
        
        int64_t sign = 0l;
        if (v > 0l) sign = 1l;
        else if (v < 0l) sign = -1l;
        int64_t step_prod = int64_t(pc.lr) * sign;
        step = step_prod >> 1;
    }
    
    if (pc.weight_decay > 0) {
        int64_t decay = (int64_t(pc.weight_decay) * curr_w) >> pc.shift;
        curr_w -= decay;
    }
    
    int64_t new_w = curr_w - step;
    weights[i] = new_w;
    
    uint needed = bits_needed_64(new_w);
    atomicMax(meta[0], needed);
}
