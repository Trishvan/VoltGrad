#version 450
#extension GL_ARB_gpu_shader_int64 : enable

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer InWeights { int64_t weights[]; };
layout(std430, binding = 1) buffer OutPacked { uint packed_data[]; };

layout(push_constant) uniform PushConstants {
    uint count;
    uint bit_width;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    
    int64_t val = weights[i];
    uint64_t raw = uint64_t(val);
    if (pc.bit_width < 64u) {
        uint64_t mask = (1ul << pc.bit_width) - 1ul;
        raw &= mask;
    }
    
    uint bit_offset = i * pc.bit_width;
    uint word_idx = bit_offset / 32u;
    uint bit_in_word = bit_offset % 32u;
    
    uint w0 = uint(raw << bit_in_word);
    atomicOr(packed_data[word_idx], w0);
    
    uint bits_in_w0 = 32u - bit_in_word;
    if (pc.bit_width > bits_in_w0) {
        uint w1 = uint(raw >> bits_in_w0);
        atomicOr(packed_data[word_idx + 1u], w1);
        
        uint rem_bits = pc.bit_width - bits_in_w0;
        if (rem_bits > 32u) {
            uint w2 = uint((raw >> bits_in_w0) >> 32u);
            atomicOr(packed_data[word_idx + 2u], w2);
        }
    }
}
